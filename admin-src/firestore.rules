rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['raintempoenterlab@gmail.com', 'aeyong250712@gmail.com'];
    }

    match /articles/{slug} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow write: if isAdmin();
    }

    match /projects/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inquiries/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['module','name','phone','createdAt'])
        && request.resource.data.keys().size() <= 12
        && request.resource.data.module is string
        && request.resource.data.module.size() <= 8
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && (!('extra' in request.resource.data) || request.resource.data.extra.size() <= 2000);
    }

    // ───── 레인템포랩 내부 어드민 (rt_ 컬렉션) ─────
    function rtSignedIn() { return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function rtEmail() { return request.auth.token.email.lower(); }
    function rtStaffDoc() { return get(/databases/$(database)/documents/rt_staff/$(rtEmail())); }
    function rtIsStaff() { return rtSignedIn() && exists(/databases/$(database)/documents/rt_staff/$(rtEmail())) && rtStaffDoc().data.get('active', true) == true; }
    function rtIsAdmin() { return rtIsStaff() && rtStaffDoc().data.get('admin', false) == true; }
    function rtCanSee(client) { return rtIsStaff() && (rtStaffDoc().data.get('all', false) == true || client in rtStaffDoc().data.get('clients', [])); }
    function rtJobClient(id) { return get(/databases/$(database)/documents/rt_jobs/$(id)).data.client; }
    function rtJobClientAfter(id) { return getAfter(/databases/$(database)/documents/rt_jobs/$(id)).data.client; }

    match /rt_staff/{email} {
      allow read: if rtIsAdmin() || (rtSignedIn() && rtEmail() == email);
      allow write: if rtIsAdmin();
    }
    match /rt_clients/{id} {
      allow read: if rtIsStaff();
      allow write: if rtIsAdmin();
    }
    match /rt_config/{id} {
      allow read: if rtIsStaff();
      allow write: if rtIsAdmin();
    }
    match /rt_jobs/{id} {
      allow read: if rtCanSee(resource.data.client);
      allow create: if rtCanSee(request.resource.data.client) && request.resource.data.version == 1;
      // 버전은 한 번에 1씩만 올라간다 (동시 수정 보호)
      allow update: if rtCanSee(resource.data.client) && rtCanSee(request.resource.data.client)
                    && request.resource.data.version == resource.data.version + 1;
      allow delete: if rtIsAdmin();
    }
    match /rt_bodies/{id} {
      allow read: if rtCanSee(rtJobClient(id));
      allow create, update: if rtCanSee(rtJobClientAfter(id));
      allow delete: if rtIsAdmin();
    }
    match /rt_history/{id} {
      allow read: if rtCanSee(rtJobClient(id));
      allow create, update: if rtCanSee(rtJobClientAfter(id));
      allow delete: if rtIsAdmin();
    }
    match /rt_subscribers/{id} {
      allow read, create, update: if rtIsStaff();
      allow delete: if rtIsAdmin();
    }
    match /rt_subcodes/{id} {
      allow read, update, delete: if rtIsAdmin();
      allow create: if rtIsStaff();
    }
    match /rt_manual/{ym} {
      allow read, write: if rtIsStaff();
    }
    match /rt_apikeys/{h} {
      allow read, write: if rtIsAdmin();
    }
    // ───── 내부 어드민 끝 ─────
  }
}
