rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // articles 컬렉션
    match /articles/{slug} {
      // 공개 읽기
      allow read: if true;

      // 조회수 증가는 비인증도 허용 (views 필드만 변경 시)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);

      // 그 외 쓰기(생성/수정/삭제)는 관리자 인증 필수
      allow write: if request.auth != null
                   && request.auth.token.email == 'raintempoenterlab@gmail.com';
    }

    // projects 컬렉션
    match /projects/{slug} {
      // 공개 읽기
      allow read: if true;

      // 쓰기는 관리자 인증 필수
      allow write: if request.auth != null
                   && request.auth.token.email == 'raintempoenterlab@gmail.com';
    }

    // inquiries 컬렉션 — 문의 폼 (공개 생성, 읽기는 관리자만)
    match /inquiries/{id} {
      allow read, update, delete: if request.auth != null
                   && request.auth.token.email == 'raintempoenterlab@gmail.com';

      // 스팸 방지: 필수 필드 존재 + 길이 제한 + 필드 수 제한
      allow create: if request.resource.data.keys().hasAll(['module','name','phone','createdAt'])
                    && request.resource.data.keys().size() <= 12
                    && request.resource.data.module is string
                    && request.resource.data.module.size() <= 8
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 50
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30
                    && (!('extra' in request.resource.data) || request.resource.data.extra.size() <= 2000);
    }
  }
}
